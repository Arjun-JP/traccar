<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>

    <!-- Cloud PostgreSQL Database -->
    <entry key='database.driver'>org.postgresql.Driver</entry>
    <entry key='database.url'>${DATABASE_URL}</entry>
    <entry key='database.user'>${DATABASE_USER}</entry>
    <entry key='database.password'>${DATABASE_PASSWORD}</entry>

    <!-- Webhook Bridge Forwarder -->
    <entry key='event.forward.enable'>true</entry>
    <entry key='forward.enable'>true</entry>
    <entry key='forward.url'>${WEBHOOK_URL}</entry>
    <entry key='forward.json'>true</entry>

    <!-- Enable GPS Tracker Protocols -->
    <entry key='watch.port'>5112</entry>
    <entry key='granit.port'>5113</entry>
    <entry key='gt06.port'>5023</entry>
    <entry key='h02.port'>5013</entry>

</properties>
